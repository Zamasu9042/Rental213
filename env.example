# Root .env — place in Rental213/ (same level as docker-compose.yml)
# Fill in your real values before running docker-compose up

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Twilio
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1234567890

# Google Vision (path to your service account JSON inside the container)
GOOGLE_APPLICATION_CREDENTIALS=/app/vision-key.json
