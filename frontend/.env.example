# ── Mock mode ─────────────────────────────────────────────────────────────────
# true  = in-browser mock data (no Docker needed, great for UI dev)
# false = live Python microservices via Vite proxy → Kong
VITE_USE_MOCKS=false

# ── Checkout mode ─────────────────────────────────────────────────────────────
# pending_payment = rental stays PENDING until Stripe webhook confirms payment
# immediate       = rental goes ACTIVE immediately (skips payment, dev shortcut)
VITE_CHECKOUT_MODE=pending_payment
