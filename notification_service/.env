# RabbitMQ – set RABBITMQ_HOST to the broker IP when running on another laptop
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Queue and exchange (must match your payment/booking service publisher)
PAYMENT_QUEUE=payment.confirmations
PAYMENT_EXCHANGE=payments

# Optional: URL for reconciliation (Notification Service sends {item, Rev} here)
# RECONCILIATION_URL=

# Optional: SMS via Twilio (get at twilio.com). Include user_phone in payload to send SMS.
 TWILIO_ACCOUNT_SID=AC54b3fbafbdb3b25ee1219b6aa4d791ec
 TWILIO_AUTH_TOKEN=24a05a9bc1c069b0b0b59bcf91a93e16
 TWILIO_PHONE_NUMBER=+13613211427
