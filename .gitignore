# ─── Secrets & environment files ─────────────────────────────────────────────
# NEVER commit these — they contain Stripe, Camunda, and Twilio credentials
.env
.env.local
.env.*.local
.env.production
.env.staging
**/.env
**/.env.local
**/.env.*.local

# Keep the example/template files (no real secrets in these)
!.env.example
!**/.env.example

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
**/.DS_Store
Thumbs.db

# ─── Build output ─────────────────────────────────────────────────────────────
frontend/dist/
frontend/.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Docker / local volumes ───────────────────────────────────────────────────
*.db
*.sqlite

